{
  "name": "mechagent-bridge-mcp-server",
  "version": "1.0.0",
  "description": "Local MCP server for MechAgent Bridge and Create on NeoForge.",
  "type": "module",
  "bin": {
    "mcpfabric": "dist/index.js",
    "mcpfabric-bench": "dist/bench/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"test/*.test.mjs\" \".test-build/test/*.test.js\"",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "bundle": "node mcpb/bundle.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "minecraft",
    "neoforge",
    "ai"
  ],
  "license": "MIT",
  "author": "Rxwkovo; derived from MCP Fabric by dabinayo",
  "homepage": "https://github.com/Rxwkovo/mcBridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rxwkovo/mcBridge.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Rxwkovo/mcBridge/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "private": true
}
